Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.8
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz/Path
      Name: Trajectory
      Enabled: true
      Topic: /trajectory
    - Class: rviz/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: map
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Scale: 80
