<!-- SLAM with gmapping, using wheel+gyro odometry from the board (odom->base_link).
     Tuned for the RPLIDAR A1 (7 Hz, ~360 beams) on a slow skid-steer robot:
     - temporalUpdate -1: only integrate scans after the robot moves, so a parked
       robot can't slowly re-register the same scan and rotate the map
     - minimumScore: reject weak scan matches and fall back to odometry
     - low odometry noise (srr..stt): encoders + gyro were calibrated -->
<launch>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange" value="6.0"/>
    <param name="maxRange" value="12.0"/>
    <param name="minimumScore" value="100"/>
    <param name="particles" value="40"/>
    <param name="linearUpdate" value="0.10"/>
    <param name="angularUpdate" value="0.10"/>
    <param name="temporalUpdate" value="-1.0"/>
    <param name="resampleThreshold" value="0.5"/>
    <param name="srr" value="0.05"/>
    <param name="srt" value="0.05"/>
    <param name="str" value="0.05"/>
    <param name="stt" value="0.05"/>
    <param name="sigma" value="0.05"/>
    <param name="lstep" value="0.05"/>
    <param name="astep" value="0.05"/>
    <param name="delta" value="0.05"/>
    <param name="xmin" value="-15"/><param name="ymin" value="-15"/>
    <param name="xmax" value="15"/><param name="ymax" value="15"/>
    <param name="transform_publish_period" value="0.05"/>
  </node>
</launch>
