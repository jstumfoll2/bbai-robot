<?xml version="1.0"?>
<package format="2">
  <name>bbai_autonomy</name>
  <version>0.1.0</version>
  <description>Autonomous mode: map the house with lidar, search it, chase the dog or kids on sight, start on boot.</description>
  <maintainer email="j.stumfoll@gmail.com">Jason Stumfoll</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
</package>
