<!-- Chase the dog: hold R2 on the PS4 controller to arm, release to stop; L1 (teleop) always overrides.
     Start robot.launch (bbai_base) and teleop.launch (bbai_teleop) first.
     dry_run:=true (default) only publishes /chase/cmd_vel_preview; pass dry_run:=false to drive.
     targets:="[dog, person]" lets you test it by walking in front of the camera.
     targets can be dog, person, kid, adult (kid/adult are persons split by estimated height).
     arm_mode:=auto drives whenever a target is tracked (used by bbai_autonomy, which
     remaps cmd_vel to chase/cmd_vel so its mux decides). -->
<launch>
  <arg name="dry_run" default="true"/>
  <arg name="targets" default="[dog]"/>
  <arg name="arm_mode" default="button"/>
  <arg name="cmd_vel" default="cmd_vel"/>
  <node pkg="bbai_chase" type="chase_node.py" name="chase" output="screen">
    <remap from="cmd_vel" to="$(arg cmd_vel)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
    <param name="arm_mode" value="$(arg arm_mode)"/>
    <rosparam param="targets" subst_value="true">$(arg targets)</rosparam>
    <param name="kid_max_height" value="1.35"/>     <!-- m; see /chase/status "(1.10m tall)" to tune -->
    <param name="camera_height" value="0.15"/>      <!-- m, OAK lens above the floor: measure it -->
    <param name="camera_pitch_deg" value="0.0"/>    <!-- + = tilted up -->
    <param name="button_chase" value="7"/>          <!-- R2 -->
    <param name="button_teleop" value="4"/>         <!-- L1, teleop deadman -->
    <param name="follow_distance" value="0.9"/>
    <param name="stop_distance" value="0.5"/>
    <param name="max_linear" value="0.2"/>          <!-- m/s, deliberately slow for first tests -->
    <param name="k_linear" value="0.4"/>
    <param name="max_angular" value="2.0"/>         <!-- requested yaw rate limit, rad/s -->
    <param name="k_angular" value="2.5"/>           <!-- above ~4 the bearing loop gets unstable -->
    <!-- Gyro yaw-rate loop: raises angular.z until the robot really turns at the requested rate -->
    <param name="yaw_loop" value="true"/>
    <param name="yaw_kp" value="1.0"/>
    <param name="yaw_ki" value="8.0"/>
    <param name="max_turn_cmd" value="8.0"/>        <!-- angular.z sent to bbai_base, ~0.47 duty -->
    <param name="min_spin_cmd" value="4.0"/>        <!-- open-loop turn floor if the gyro is silent -->
    <!-- Detector input: true = centre crop (~39 deg view), false = full width squashed (~65 deg) -->
    <param name="preview_keep_aspect" value="true"/>
    <param name="bearing_deadband_deg" value="5.0"/>
    <param name="lost_timeout" value="0.5"/>
  </node>
</launch>
